import numpy as np 
import pandas as pd 
import matplotlib.pyplot as plt
x=np.array(range(1,6))
y=np.array(range(3,12,2))
m=0
b=0
lr=0.01
echo=1000
n=len(x)

for i in range(echo):
    y_pred=m*x+b
    dm=(2/n)*sum( x*(y_pred-y))
    db=(2/n)*sum(y_pred-y) 
    m=m-lr*dm
    b=b-lr*db

mse=np.mean((y_pred-y)**2)
print("mse:",mse)
r_square=1-(np.sum((y-y_pred)**2)/np.sum((y-np.mean(y))**2))
print("r_square:",r_square)

print(f"slope(m):{m} intercept(b):{b}")
plt.scatter(x,y)
plt.plot(x,y_pred,color='r')
plt.show()
